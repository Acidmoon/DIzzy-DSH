{
  "name": "dizzy-dsh",
  "private": true,
  "dependencies": {
    "dizzy-dsh-balance": "file:./plugins/balance",
    "dizzy-dsh-usage-card": "file:./plugins/usage-card",
    "dizzy-dsh-agent-instructions": "file:./plugins/agent-instructions",
    "dizzy-dsh-kimi-webbridge": "file:./plugins/kimi-webbridge",
    "dsh-better-sidebar": "0.10.3",
    "@dsh-external/dsh-vision-toolkit": "file:./third-party/dsh-vision-toolkit",
    "@omdsh-dev/dsh-genui": "file:./third-party/dsh-genui",
    "dsh-notification": "file:./third-party/dsh-notification"
  },
  "version": "0.3.0",
  "description": "Dizzy-DSH 插件合集仓库:git clone 后 dsh plugin add 即装,无需 npm 发布。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
